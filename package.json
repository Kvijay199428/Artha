  "scripts": {
    "server": "node server.js",
    "postinstall": "node scripts/bundle-tesseract-assets.mjs",
    "prebuild": "node scripts/bundle-tesseract-assets.mjs",
    "dev": "node scripts/bundle-tesseract-assets.mjs && node server.js & vite",
    "dev:win": "node scripts/bundle-tesseract-assets.mjs && (start /b node server.js) && vite",
    "build": "vite build",
    "start": "vite build && node server.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "bundle:tesseract": "node scripts/bundle-tesseract-assets.mjs",
    "bundle:source": "node scripts/generate-artha-md.mjs",
    "release:zip": "npm run build && node scripts/build-release-zip.mjs && node scripts/verify-release.mjs",
    "test": "npm run test:unit && node tests/smoke.mjs",
    "test:unit": "node scripts/tax-test.mjs && node scripts/discount-modes-test.mjs && node scripts/csv-test.mjs",
    "test:install": "playwright install firefox",
    "test:update-unix": "node scripts/test-update-unix.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "launcher:build": "dotnet build launcher/ARTHA.Launcher.csproj -c Release",
    "launcher:publish": "dotnet publish launcher/ARTHA.Launcher.csproj -c Release -r win-x64 --self-contained true /p:PublishSingleFile=true /p:EnableCompressionInSingleFile=true /p:IncludeNativeLibrariesForSelfExtract=true -o publish-launcher",
    "installer:publish": "dotnet publish installer/ARTHA.Installer.csproj -c Release -r win-x64 --self-contained true /p:PublishSingleFile=true /p:EnableCompressionInSingleFile=true /p:IncludeNativeLibrariesForSelfExtract=true -o publish-installer",
    "theme:audit": "node scripts/theme-audit.mjs"
  },
