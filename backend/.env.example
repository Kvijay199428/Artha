# Backend Environment Variables
# Copy this to .env and fill in values for production

APP_ENV=production
DATABASE_URL=sqlite:///./storage/artha.db
SECRET_KEY=change-this-to-a-long-random-string-at-least-32-chars
SESSION_SECRET=change-this-to-another-long-random-string
STORAGE_PATH=storage
LOG_LEVEL=INFO

# CORS: Leave empty for production with Nginx proxy (same-origin, no CORS needed)
# For development set to your Vite dev server:
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ORIGINS=