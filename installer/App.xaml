<Application x:Class="ARTHA.Installer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#0B0F19"/>
        <SolidColorBrush x:Key="CardDark" Color="#111827"/>
        <SolidColorBrush x:Key="CardLight" Color="#1E293B"/>
        <SolidColorBrush x:Key="BorderDark" Color="#1F2937"/>
        <SolidColorBrush x:Key="BorderLight" Color="#334155"/>
        <SolidColorBrush x:Key="TextWhite" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>
    </Application.Resources>
</Application>

